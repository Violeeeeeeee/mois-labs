Cell[TextData[{
 "Narysuj wykres funkcji ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", 
     RowBox[{"x", ",", "y"}], ")"}], "=", 
    RowBox[{"Cos", "(", 
     SqrtBox[
      RowBox[{
       SuperscriptBox["x", "2"], "+", 
       SuperscriptBox["y", "2"]}]], ")"}]}], TraditionalForm]],ExpressionUUID->
  "eadc2959-ee64-44d4-9d46-fc8f376e67df"],
 " w wybranym obszarze. Poeksperymentuj z opcjami ",
 StyleBox["PlotPoints ", "Program",
  FontFamily->"Courier"],
 StyleBox["aby otrzymac ladny wykres.",
  FontFamily->"Times New Roman"]
}], "Text",
 PageWidth->PaperWidth,
 CellMargins->{{11, 5}, {Inherited, Inherited}},
 Evaluatable->False,
 AspectRatioFixed->
  True,ExpressionUUID->"ade61e21-9b85-4a40-8eb9-c826e2ef5e8a"]
}, Open  ]],

