Cell[TextData[{
 "U\:017cyj funkcji ",
 StyleBox["Plot", "Program"],
 " do narysowania ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "x", ")"}], " ", "=", " ", 
    RowBox[{"Sin", "(", 
     RowBox[{"1", "/", "x"}], ")"}], " "}], TraditionalForm]],ExpressionUUID->
  "96d47901-4f9b-46b7-8707-46a90e406fd2"],
