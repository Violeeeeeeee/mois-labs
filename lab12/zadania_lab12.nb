Cell[TextData[{
 "Dana jest funkcja ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "x", ")"}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["x", "3"], "+", "x", "+", "1"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["x", "4"], "+", "1"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"d68360f0-5af4-4472-8841-ecae28070eb4"],
 ".\n(a)  Znajd\.9f wzory",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "'"}], 
    RowBox[{"(", "x", ")"}]}], TraditionalForm]],ExpressionUUID->
  "b7fa6550-5b7c-4969-9de5-7b4c648c24b7"],
 " i",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     RowBox[{
      RowBox[{"f", "'"}], "'"}], 
     RowBox[{"(", "x", ")"}], " ", "symbolicznie"}]}], TraditionalForm]],
  ExpressionUUID->"af90e495-14d3-4fff-92e3-ec6c4e6d5b86"],
 "\n(b) Znajd\.9f miejsca zerowe funkcji ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "'"}], 
    RowBox[{"(", "x", ")"}]}], TraditionalForm]],ExpressionUUID->
  "637c591c-5c40-4b8a-b4d9-0c9dd50dbf9b"],
 " i ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], "'"}], 
    RowBox[{"(", "x", ")"}]}], TraditionalForm]],ExpressionUUID->
  "ae3b0a7b-66c0-4ee5-a2c2-fee054e68650"],
 ". Jak wiadomo z analizy, s\[SHacek] to mo\:017cliwe ekstrema funkcji ",
 StyleBox["f(x)", "Program"],
 "\n(c)  Narysuj wykresy ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "(", "x", ")"}], TraditionalForm]],ExpressionUUID->
  "c97f26ee-7eae-4cd1-a14a-2f267c6c4e29"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "'"}], 
    RowBox[{"(", "x", ")"}]}], TraditionalForm]],ExpressionUUID->
  "42b57834-104b-4740-9994-26566d79e4bf"],
 " i ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], "'"}], 
    RowBox[{"(", "x", ")"}]}], TraditionalForm]],ExpressionUUID->
  "5a926d06-f30e-482a-9317-03c725b16aef"],
 " na jednym wykresie r\[OAcute]\:017cnymi kolorami. Zinterpretuj rysunek- kt\
\[OAcute]re punkty odnalezione w (b) s\[SHacek] eksterami, a kt\[OAcute]re \
punktami przegi\:0119cia ?"
}], "Text",
 PageWidth->PaperWidth,
 CellMargins->{{11, 5}, {Inherited, Inherited}},
 Evaluatable->False,
 AspectRatioFixed->
  True,ExpressionUUID->"2708c918-dcca-424a-b33c-2fcda665d87f"]
}, Open  ]],

