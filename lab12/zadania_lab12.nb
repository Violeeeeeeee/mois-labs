Cell[TextData[{
 "Dane s\[SHacek] funkcje ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "x", ")"}], "=", 
    RowBox[{
     RowBox[{"2", 
      SuperscriptBox["x", "3"]}], "-", 
     RowBox[{"6", "x"}], "+", "3"}]}], TraditionalForm]],ExpressionUUID->
  "567d18b2-9bab-460c-beb6-6ff9a74ae158"],
 " i  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "(", "x", ")"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "4"}], 
      SuperscriptBox["x", "3"]}], "+", 
     RowBox[{"3", 
      SuperscriptBox["x", "2"]}], "+", "2"}]}], TraditionalForm]],
  ExpressionUUID->"83bdb86e-7c03-4662-bbda-1e6987921b2d"],
 " .\n(a)  U\:017cywajac graficznych funkcji narysuj obie funkcje na jednym \
wykresie i oszacuj punkty przeci\:0119cia si\:0119 funkcji.\n(b)  Znajd\.9f \
punkty przeci\:0119cia si\:0119 dw\[OAcute]ch krzywych symbolicznie.\n(c)  \
Znajd\.9f punkty przeci\:0119cia si\:0119 dw\[OAcute]ch krzywych numerycznie ."
}], "Text",
 PageWidth->PaperWidth,
 CellMargins->{{11, 5}, {Inherited, Inherited}},
 Evaluatable->False,
 AspectRatioFixed->
  True,ExpressionUUID->"fb43e795-1622-4387-96e9-8535b96dc878"]
}, Open  ]],

