Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Zadanie", " ", "4"}], ":", 
    RowBox[{"Funkcja", " ", "TrigFit", " ", 
     RowBox[{"(", 
      RowBox[{"Aproksymacja", " ", "Trygonometryczna"}], ")"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Generujemy", " ", "zaszumione", " ", "dane", " ", "okresowe", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"np", ".", "wahania"}], " ", "jakiego\:015b", " ", 
      "sygna\[LSlash]u"}], ")"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"trigData", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"5", "+", 
          RowBox[{"3", " ", 
           RowBox[{"Sin", "[", "x", "]"}]}], "+", 
          RowBox[{"2", " ", 
           RowBox[{"Cos", "[", 
            RowBox[{"2", " ", "x"}], "]"}]}], "+", 
          RowBox[{"RandomReal", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "10", ",", "0.2"}], "}"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"plotTrigData", "=", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"trigData", ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"PointSize", "[", "0.02", "]"}], ",", "Black"}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", "\"\<zaszumione dane okresowe\>\"", "}"}]}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Wykonujemy", " ", "dopasowanie", " ", "trygonometryczne", " ", 
     RowBox[{"(", 
      RowBox[{
      "wsp\[OAcute]\[LSlash]czesny", " ", "odpowiednik", " ", "TrigFit"}], 
      ")"}], " ", "Jako", " ", "baz\:0119", " ", "podajemy", " ", 
     "jedynk\:0119", " ", "oraz", " ", "sinusy", " ", "i", " ", "cosinusy", " ",
      "wielokrotno\:015bci", " ", "x"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"modernTrigFit", "=", 
     RowBox[{"Fit", "[", 
      RowBox[{"trigData", ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{"Sin", "[", "x", "]"}], ",", 
         RowBox[{"Cos", "[", "x", "]"}], ",", 
         RowBox[{"Sin", "[", 
          RowBox[{"2", " ", "x"}], "]"}], ",", 
         RowBox[{"Cos", "[", 
          RowBox[{"2", " ", "x"}], "]"}]}], "}"}], ",", "x"}], "]"}]}], ";"}],
    "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotModernTrigFit", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{"modernTrigFit", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "10"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", "Thick"}], ",", 
       RowBox[{"ColorFunction", "->", "\"\<Rainbow\>\""}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{
        "{", "\"\<Trigonometric Approximation (TrigFit)\>\"", "}"}]}]}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{"plotModernTrigFit", ",", "plotTrigData", ",", 
     RowBox[{
