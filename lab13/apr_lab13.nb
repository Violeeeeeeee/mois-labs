Notebook[{
Cell["Funkcja Fit", "Text",ExpressionUUID->"8f6043aa-e019-4e95-b7b5-52157f696bda"],

Cell[TextData[{
 StyleBox["Fit[", "MR"],
 StyleBox["data", "TI"],
 StyleBox[",", "MR"],
 " ",
 StyleBox["funs", "TI"],
 StyleBox[",", "MR"],
 " ",
 StyleBox["vars", "TI"],
 StyleBox["]", "MR"],
 "  stosuje aproksymacje kwadratowa  \ndata - punkty wejsciowe aproksymacji \n\
funs - funkcje bazowe\nvars - lista argumentow funkcji bazowych.\n\nPrzyklad:\
\n"
}], "Usage",
 CellTags->{
  "S0.1193", "Fit"},ExpressionUUID->"addc2dbb-6391-46c0-a6d1-1d15178df6b3"],

Cell["Tworzymy tabele liczb pierwszych", "ExampleText",
 CellTags->"Fit",ExpressionUUID->"bdb5864d-988a-43db-8f05-a0a038d51d79"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"tableprimes", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Prime", "[", "x", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "20"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}]], "Input",
 CellTags->"Fit",ExpressionUUID->"89fb0998-b221-4a6a-8fa6-fb061b0c9f89"],

Cell["Pokazujemy je na wykresie", "Text",
 CellTags->"Fit",ExpressionUUID->"d5e910f4-50ff-44de-80b8-e1fa4767259a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"plotprimes", "=", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"tableprimes", ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"PointSize", "[", "0.02", "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellTags->"Fit",ExpressionUUID->"5aa3c2f1-02e4-4c6e-b663-e5b6028bbfe3"],

