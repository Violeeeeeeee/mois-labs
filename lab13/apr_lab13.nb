Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Zadanie", " ", "2"}], ":", " ", 
    RowBox[{"Aproksymacja", " ", "w\[LSlash]asnej", " ", "funkcji"}]}], 
   "*)"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "At", " ", "first", " ", "i", " ", "thought", " ", "about", " ", "the", " ",
      "cooling", " ", "of", " ", "Earth`s", " ", "surface", " ", "at", " ", 
     "night", " ", "and", " ", "how", " ", "i", " ", "could", " ", 
     "calculate", " ", "it"}], ",", " ", 
    RowBox[{
    "then", " ", "on", " ", "Mars", " ", "and", " ", "i", " ", "found", " ", 
     "good", " ", "explanation", " ", "of", " ", "how", " ", "it", " ", 
     "works", " ", "with", " ", "almost", " ", "no", " ", "atmosphere"}]}], 
   "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Radiant", " ", "Heat", " ", "Loss", " ", "of", " ", "a", " ", "Human", " ",
     "on", " ", "Mars"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Based", " ", "on", " ", "the", " ", "Stefan"}], "-", 
    RowBox[{
    "Boltzmann", " ", "Law", " ", "from", " ", "the", " ", "Quora", " ", 
     "post"}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"https", ":"}], "//", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"en", ".", "wikipedia", ".", "org"}], "/", "wiki"}], "/", 
      "Climate_of"}], "_Mars", "#Temperature"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"https", ":"}], "//", 
    RowBox[{
     RowBox[{
      RowBox[{"www", ".", "quora", ".", "com"}], "/", "What"}], "-", "is", "-",
      "the", "-", "temperature", "-", "at", "-", "the", "-", "Equator", "-", 
     "of", "-", "Mars", "-", "and", "-", "what", "-", "is", "-", "the", "-", 
     "lowest", "-", "temperature", "-", "the", "-", "following", "-", "area", 
     "-", "can", "-", "drop", "-", "to"}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Constants", ":", "e"}], "=", "0.95"}], ",", 
    RowBox[{"sigma", "=", 
     RowBox[{"5.67", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "8"}]}]}]}], ",", 
    RowBox[{"A", "=", 
     RowBox[{"1.7", " ", 
      RowBox[{"m", "^", "2"}]}]}], ",", 
    RowBox[{"T_skin", "=", 
     RowBox[{"306.15", " ", "K", " ", 
      RowBox[{"(", 
       RowBox[{"33", " ", "C"}], ")"}]}]}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "The", " ", "function", " ", "calculates", " ", "Watts", " ", "lost", " ", 
    "based", " ", "on", " ", "ambient", " ", "temperature", " ", "in", " ", 
    "Kelvin", " ", 
    RowBox[{"(", "Ta", ")"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"heatLossFunc", "[", "Ta_", "]"}], ":=", 
    RowBox[{"0.95", "*", "5.67", "*", 
     RowBox[{"10", "^", 
      RowBox[{"-", "8"}]}], "*", "1.7", "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"306.15", "^", "4"}], "-", 
       RowBox[{"Ta", "^", "4"}]}], ")"}]}]}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Generate", " ", "data", " ", "points", " ", "for", " ", "Martian", " ", 
     "temperatures", " ", "from", " ", "150", "K", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "123"}], " ", "C"}], ")"}], " ", "to", " ", "293", "K", " ", 
     RowBox[{"(", 
      RowBox[{"20", " ", "C"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"marsHeatData", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Ta", ",", 
         RowBox[{"heatLossFunc", "[", "Ta", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Ta", ",", "150", ",", "293", ",", "5"}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"plotMarsHeatData", "=", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"marsHeatData", ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"PointSize", "[", "0.02", "]"}], ",", "Orange"}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", "\"\<Actual Radiant Heat Loss [Watts]\>\"", "}"}]}]}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Approximate", " ", "the", " ", 
     RowBox[{"T", "^", "4"}], " ", "radiation", " ", "curve", " ", "using", " ",
      "a", " ", "quadratic", " ", "polynomial"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"quadraticFitHeat", "=", 
     RowBox[{"Fit", "[", 
      RowBox[{"marsHeatData", ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "Ta", ",", 
         RowBox[{"Ta", "^", "2"}]}], "}"}], ",", "Ta"}], "]"}]}], ";"}], "\n",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotQuadraticFitHeat", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{"quadraticFitHeat", ",", 
       RowBox[{"{", 
        RowBox[{"Ta", ",", "150", ",", "293"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", "Blue"}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", "\"\<Quadratic Approximation\>\"", "}"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{"plotQuadraticFitHeat", ",", "plotMarsHeatData", ",", 
     RowBox[{
     "PlotLabel", 
      "->", "\"\<Human Radiant Heat Loss on Mars: Quadratic Fit\>\""}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Ambient Temp [Kelvin]\>\"", 
        ",", "\"\<Heat Loss [Watts]\>\""}], "}"}]}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.98110757587348*^9, 3.981107628671476*^9}, {
   3.981107662051083*^9, 3.9811076802177343`*^9}, {3.98110809113385*^9, 
