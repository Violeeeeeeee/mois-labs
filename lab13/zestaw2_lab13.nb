          RowBox[{"2", " ", "x"}], "+", "5"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "4"}], ",", "2"}], "}"}], ",", 
       RowBox[{
       "PlotLabel", 
        "->", "\"\<Przypadek 3: 0 punkt\[OAcute]w (a=2, b=5)\>\""}]}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
