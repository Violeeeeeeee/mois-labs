Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Zadanie", " ", "1"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Definiujemy", " ", "og\[OAcute]lny", " ", "wielomian", " ", "3", " ", 
     "go", " ", 
     RowBox[{"stopnia", ".", " ", "ClearAll"}], " ", "usuwa", " ", 
     "poprzednie", " ", "przypisania", " ", "z", " ", "pami\:0119ci"}], ",", 
    RowBox[{
    "by", " ", "unikn\:0105\[CAcute]", " ", "b\[LSlash]\:0119d\[OAcute]w"}]}],
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"cubic", ",", "a", ",", "b", ",", "c", ",", "d", ",", "x"}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"cubic", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{"a", " ", 
       RowBox[{"x", "^", "3"}]}], "+", 
      RowBox[{"b", " ", 
       RowBox[{"x", "^", "2"}]}], "+", 
      RowBox[{"c", " ", "x"}], "+", "d"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"punkty", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"4", ",", "1"}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rownania", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"cubic", "[", "1", "]"}], "==", "3"}], ",", 
       RowBox[{
        RowBox[{"cubic", "[", "2", "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{"cubic", "[", "3", "]"}], "==", "4"}], ",", 
       RowBox[{
        RowBox[{"cubic", "[", "4", "]"}], "==", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"wspolczynniki", "=", 
    RowBox[{"Solve", "[", 
     RowBox[{"rownania", ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gotowyWielomian", "[", "x_", "]"}], "=", 
    RowBox[{
     RowBox[{"cubic", "[", "x", "]"}], "/.", " ", 
     RowBox[{"wspolczynniki", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"gotowyWielomian", "[", "x", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "5"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", "Blue"}]}], "]"}], ",", 
     RowBox[{"ListPlot", "[", 
