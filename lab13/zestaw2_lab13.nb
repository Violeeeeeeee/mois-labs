Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Zadanie", " ", "2", " ", 
    RowBox[{"(", 
     RowBox[{"3", " ", "przypadki"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
  
  RowBox[{"(*", 
   RowBox[{"Symboliczne", " ", "rozwi\:0105zanie", " ", "przeci\:0119cia"}], 
   "*)"}], 
  RowBox[{
   RowBox[{"punktyPrzeciecia", "=", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"x", "^", "2"}], "==", 
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{"x", "^", "2"}]}], "+", 
        RowBox[{"a", " ", "x"}], "+", "b"}]}], ",", "x"}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Przypadek", " ", "1"}], ":", 
       RowBox[{"Dwa", " ", "punkty", " ", "przeci\:0119cia", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Delta", ">", "0"}], ")"}], ".", "Wybieramy"}], " ", 
        RowBox[{"np", ".", "a"}]}]}], "=", "3"}], ",", " ", 
     RowBox[{"b", "=", 
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{"Delta", "=", 
         RowBox[{
          RowBox[{"9", "-", "8"}], "=", "1"}]}], ")"}]}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"plot1", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "^", "2"}], ",", 
         RowBox[{
          RowBox[{"2", " ", 
           RowBox[{"x", "^", "2"}]}], "+", 
          RowBox[{"3", " ", "x"}], "+", "2"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "4"}], ",", "2"}], "}"}], ",", 
       RowBox[{
       "PlotLabel", "->", "\"\<Przypadek 1: 2 punkty (a=3, b=2)\>\""}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<y = x^2\>\"", ",", "\"\<y = 2x^2 + 3x + 2\>\""}], 
         "}"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Przypadek", " ", "2"}], ":", 
       RowBox[{"Jeden", " ", "punkt", " ", 
        RowBox[{"przeci\:0119cia", "/", "Styczno\:015b\[CAcute]"}], " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Delta", "=", "0"}], ")"}], ".", "Wybieramy"}], " ", 
        RowBox[{"np", ".", "a"}]}]}], "=", "4"}], ",", 
     RowBox[{"b", "=", 
      RowBox[{"4", " ", 
       RowBox[{"(", 
        RowBox[{"Delta", "=", 
         RowBox[{
          RowBox[{"16", "-", "16"}], "=", "0"}]}], ")"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plot2", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "^", "2"}], ",", 
         RowBox[{
          RowBox[{"2", " ", 
           RowBox[{"x", "^", "2"}]}], "+", 
          RowBox[{"4", " ", "x"}], "+", "4"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "5"}], ",", "1"}], "}"}], ",", 
       RowBox[{
       "PlotLabel", "->", "\"\<Przypadek 2: 1 punkt (a=4, b=4)\>\""}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Przypadek", " ", "3"}], ":", 
       RowBox[{"Brak", " ", "punkt\[OAcute]w", " ", "przeci\:0119cia", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Delta", "<", "0"}], ")"}], ".", "Wybieramy"}], " ", 
        RowBox[{"np", ".", "a"}]}]}], "=", "2"}], ",", 
     RowBox[{"b", "=", 
      RowBox[{"5", " ", 
       RowBox[{"(", 
        RowBox[{"Delta", "=", 
         RowBox[{
          RowBox[{"4", "-", "20"}], "=", 
          RowBox[{"-", "16"}]}]}], ")"}]}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"plot3", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "^", "2"}], ",", 
