Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Zadanie", " ", "3", "b"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"b", ")"}], " ", "Rysowanie", " ", "hiperboli"}], "*)"}], 
  RowBox[{"ParametricPlot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"3", " ", 
         RowBox[{"Cosh", "[", "t", "]"}]}], ",", 
        RowBox[{"2", " ", 
         RowBox[{"Sinh", "[", "t", "]"}]}]}], "}"}], ",", 
